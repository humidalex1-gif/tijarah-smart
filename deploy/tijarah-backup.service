[Unit]
Description=Tijarah Smart nightly database backup
# The app need not be running — the backup reads the file, not the service —
# but ordering after it keeps the journal readable.
After=tijarah.service

[Service]
Type=oneshot
User=tijarah
WorkingDirectory=/opt/tijarah
ExecStart=/usr/bin/node /opt/tijarah/deploy/backup-db.cjs

# Same hardening as the app. The job writes in exactly one place.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tijarah/backups
