# Copy this file to .env and fill in the values. Never commit .env.
# Local development uses SQLite; the Prisma schema is PostgreSQL-portable.

# Database connection. For local dev this is the bundled SQLite file.
# In production, point it at your Postgres/SQLite database.
DATABASE_URL="file:./dev.db"

# Signs login sessions AND derives the key that encrypts stored
# Salla / Fast Hub credentials (see src/lib/crypto.ts).
# Generate a strong value with:  openssl rand -base64 48
AUTH_SECRET=""

# Public base URL (scheme, no trailing slash). Used for the Salla OAuth
# callback, which must match the Callback URL registered in Salla exactly.
APP_URL="http://localhost:3000"
